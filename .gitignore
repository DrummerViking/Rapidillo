# ========================
# Dependencias
# ========================
node_modules/

# ========================
# Variables de entorno (contraseñas, claves secretas)
# ========================
.env
.env.local
.env.production

# ========================
# Archivos del sistema
# ========================
.DS_Store           # Mac
Thumbs.db           # Windows
desktop.ini         # Windows

# ========================
# Logs (archivos de errores automáticos)
# ========================
*.log
npm-debug.log*

# ========================
# VS Code (opcional, preferencia personal)
# ========================
.vscode/

# ========================
# Archivos de construcción (si se generan)
dist/
build/

# ========================
# Archivos de cobertura de pruebas (si se generan)
coverage/

# ========================
# Otros archivos temporales o de configuración local
.idea/              # JetBrains IDEs
*.sublime-workspace # Sublime Text
*.sublime-project   # Sublime Text
*.swp               # Vim swap files
*.bak               # Archivos de respaldo
*.tmp               # Archivos temporales
Tests/               # Carpeta de pruebas (si no se desea incluir)